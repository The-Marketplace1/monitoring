    {"id":"platform-service-outage","domain":"platform","signals":["metrics","logs","traces"],"category":"service-outage","severity":"critical","condition":"service availability ratio remains below 0.995 for 5 minutes","threshold":{"metric_ref":"marketplace:availability:ratio5m","operator":"<","value":0.995,"unit":"ratio","window":"5m"},"metric_refs":["marketplace:availability:ratio5m"],"for":"5m","owner":"platform-on-call","escalation":"sev1-after-10m","runbook":"incidents/runbooks/platform-availability.md"},
    {"id":"api-gateway-dependency-failure","domain":"api-gateway","signals":["metrics","traces"],"category":"dependency-failure","severity":"high","condition":"classified upstream error rate exceeds 0.05 errors per second for 10 minutes","threshold":{"metric_ref":"marketplace.service.errors","operator":">","value":0.05,"unit":"errors_per_second","window":"5m"},"metric_refs":["marketplace.service.errors"],"for":"10m","owner":"api-gateway-on-call","escalation":"service-owner-then-platform","runbook":"incidents/runbooks/api-gateway-latency.md"},
    {"id":"api-gateway-high-latency","domain":"api-gateway","signals":["metrics","traces"],"category":"latency","severity":"high","condition":"API Gateway p95 request latency exceeds 750 milliseconds for 10 minutes","threshold":{"metric_ref":"marketplace:latency:p95_5m","operator":">","value":750,"unit":"ms","window":"5m"},"metric_refs":["marketplace:latency:p95_5m"],"for":"10m","owner":"api-gateway-on-call","escalation":"service-owner-then-platform","runbook":"incidents/runbooks/api-gateway-latency.md"},
    {"id":"auth-failure-spike","domain":"auth","signals":["metrics","logs","traces"],"category":"security-anomaly","severity":"high","condition":"authentication failure rate exceeds 0.1 failures per second for 10 minutes","threshold":{"metric_ref":"marketplace.security.authentication.failures","operator":">","value":0.1,"unit":"failures_per_second","window":"10m"},"metric_refs":["marketplace.security.authentication.failures","marketplace.security.authentication.attempts"],"for":"10m","owner":"identity-on-call","escalation":"security-on-call-after-10m","runbook":"incidents/runbooks/auth-failure-spike.md"},
