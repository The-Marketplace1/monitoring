{
  "format": "marketplace.metric-definitions.v1",
  "deployment_status": "not_deployed",
  "definitions": [
    {"id":"http.server.request.duration","domain":"application","type":"histogram","unit":"ms","description":"Elapsed time for one completed HTTP server request; use route templates, never raw URLs.","attributes":["service.name","deployment.environment.name","http.route","http.request.method","http.response.status_code"],"collection":"record once at request completion"},
    {"id":"http.server.request.count","domain":"application","type":"counter","unit":"requests","description":"Completed HTTP server requests, partitioned by bounded route and status dimensions.","attributes":["service.name","deployment.environment.name","http.route","http.request.method","http.response.status_code"],"collection":"increment once at request completion"},
    {"id":"rpc.server.duration","domain":"application","type":"histogram","unit":"ms","description":"Elapsed time for one server-side RPC operation.","attributes":["service.name","deployment.environment.name","rpc.system","rpc.method"],"collection":"record once at RPC completion"},
    {"id":"marketplace.service.errors","domain":"application","type":"counter","unit":"errors","description":"Service errors grouped by bounded operation and safe error code; exclude request or customer identifiers.","attributes":["service.name","deployment.environment.name","operation","error_code"],"collection":"increment once per classified service error"},
    {"id":"marketplace.service.health.status","domain":"application","type":"gauge","unit":"state_code","description":"Service health state code: unavailable=0, degraded=1, healthy=2, unknown=-1.","attributes":["service.name","deployment.environment.name","region"],"collection":"refresh on health-state transition and at least every 30 seconds"},
    {"id":"marketplace.gateway.upstream.errors","domain":"application","type":"counter","unit":"errors","description":"API Gateway upstream failures grouped by bounded dependency and safe failure class.","attributes":["service.name","dependency.name","error_code","region"],"collection":"increment once per failed upstream request"},
    {"id":"host.cpu.utilization","domain":"infrastructure","type":"gauge","unit":"ratio","description":"Host CPU busy fraction in the closed interval from zero to one.","attributes":["host.name","deployment.environment.name","cloud.region"],"collection":"sample every 30 seconds"},
    {"id":"host.memory.utilization","domain":"infrastructure","type":"gauge","unit":"ratio","description":"Host memory used fraction in the closed interval from zero to one.","attributes":["host.name","deployment.environment.name","cloud.region"],"collection":"sample every 30 seconds"},
    {"id":"host.disk.io","domain":"infrastructure","type":"counter","unit":"bytes","description":"Cumulative host disk bytes read or written, separated by direction.","attributes":["host.name","deployment.environment.name","device","direction"],"collection":"sample cumulative value every 30 seconds"},
    {"id":"host.network.errors","domain":"infrastructure","type":"counter","unit":"packets","description":"Cumulative host network packet errors by interface and direction.","attributes":["host.name","deployment.environment.name","interface","direction"],"collection":"sample cumulative value every 30 seconds"},
    {"id":"container.restarts","domain":"infrastructure","type":"counter","unit":"restarts","description":"Container restart events by service and bounded workload identity.","attributes":["service.name","deployment.environment.name","workload"],"collection":"increment on restart event"},
    {"id":"marketplace.capacity.utilization","domain":"infrastructure","type":"gauge","unit":"ratio","description":"Utilization of a named bounded resource such as CPU, memory, workers, or connections.","attributes":["service.name","deployment.environment.name","resource","region"],"collection":"sample every 30 seconds"},
    {"id":"marketplace.gateway.saturation","domain":"infrastructure","type":"gauge","unit":"ratio","description":"API Gateway worker or connection-pool utilization as a fraction of configured capacity.","attributes":["service.name","deployment.environment.name","resource","region"],"collection":"sample every 30 seconds"},
    {"id":"marketplace.worker.utilization","domain":"infrastructure","type":"gauge","unit":"ratio","description":"Backend worker-pool utilization as a fraction of its configured capacity.","attributes":["service.name","deployment.environment.name","worker_pool","region"],"collection":"sample every 30 seconds"},
    {"id":"db.client.operation.duration","domain":"database","type":"histogram","unit":"ms","description":"Client-observed database operation duration by safe operation class, not query text.","attributes":["db.system","server.address","deployment.environment.name","operation"],"collection":"record once per completed database operation"},
    {"id":"db.client.connections.usage","domain":"database","type":"gauge","unit":"connections","description":"Database client connection count, including bounded pool state.","attributes":["db.system","server.address","deployment.environment.name","state"],"collection":"sample every 30 seconds"},
    {"id":"db.client.operation.errors","domain":"database","type":"counter","unit":"errors","description":"Database operation failures grouped by safe error class and operation class.","attributes":["db.system","server.address","deployment.environment.name","error_code","operation"],"collection":"increment once per failed operation"},
    {"id":"marketplace.database.health","domain":"database","type":"gauge","unit":"state_code","description":"Database dependency health state code: unavailable=0, degraded=1, healthy=2, unknown=-1.","attributes":["db.system","server.address","deployment.environment.name","region"],"collection":"refresh on transition and at least every 30 seconds"},
    {"id":"marketplace.database.connection.utilization","domain":"database","type":"gauge","unit":"ratio","description":"Database connections in use divided by the configured connection limit.","attributes":["db.system","server.address","deployment.environment.name","pool"],"collection":"sample every 30 seconds"},
    {"id":"marketplace.database.replication.lag","domain":"database","type":"gauge","unit":"s","description":"Observed database replication delay in seconds; do not expose row or customer data.","attributes":["db.system","server.address","deployment.environment.name","replica_role"],"collection":"sample every 30 seconds"},
    {"id":"marketplace.database.backup.age","domain":"database","type":"gauge","unit":"s","description":"Age of the most recent successful backup in seconds.","attributes":["db.system","deployment.environment.name","backup_class"],"collection":"sample every 5 minutes"},
    {"id":"marketplace.postgis.query.errors","domain":"database","type":"counter","unit":"errors","description":"PostGIS operation failures grouped by safe operation class, never by coordinates or query text.","attributes":["db.system","deployment.environment.name","operation","error_code"],"collection":"increment once per failed spatial operation"},
    {"id":"marketplace.realtime.connections","domain":"realtime","type":"gauge","unit":"connections","description":"Current realtime connections by transport and region; do not use account or channel identifiers.","attributes":["service.name","deployment.environment.name","transport","region"],"collection":"sample every 15 seconds"},
    {"id":"marketplace.realtime.message.duration","domain":"realtime","type":"histogram","unit":"ms","description":"Time from accepted realtime event to transport delivery, without recording payloads.","attributes":["service.name","deployment.environment.name","transport","region"],"collection":"record once per delivery"},
    {"id":"marketplace.realtime.disconnects","domain":"realtime","type":"counter","unit":"disconnects","description":"Realtime disconnect events grouped by bounded safe reason and transport.","attributes":["service.name","deployment.environment.name","transport","reason","region"],"collection":"increment once per disconnect"},
    {"id":"marketplace.realtime.delivery.failures","domain":"realtime","type":"counter","unit":"failures","description":"Realtime delivery failures by safe failure class and transport.","attributes":["service.name","deployment.environment.name","transport","reason","region"],"collection":"increment once per failed delivery"},
    {"id":"marketplace.realtime.subscription.failures","domain":"realtime","type":"counter","unit":"failures","description":"Realtime subscription failures by safe reason; never label with private channel names.","attributes":["service.name","deployment.environment.name","transport","reason","region"],"collection":"increment once per failed subscription"},
    {"id":"marketplace.location.updates","domain":"location","type":"counter","unit":"updates","description":"Accepted location update count; never attach coordinates, device identifiers, or person identifiers.","attributes":["service.name","deployment.environment.name","provider","region","result"],"collection":"increment once per accepted or rejected update"},
    {"id":"marketplace.location.update_age","domain":"location","type":"gauge","unit":"s","description":"Age of the newest processed location update, in seconds, without retaining its coordinates.","attributes":["service.name","deployment.environment.name","provider","region"],"collection":"sample every 15 seconds"},
    {"id":"marketplace.location.lookup.duration","domain":"location","type":"histogram","unit":"ms","description":"Duration of a location lookup by bounded lookup class, without coordinate values.","attributes":["service.name","deployment.environment.name","provider","region"],"collection":"record once per lookup"},
    {"id":"marketplace.location.processing.failures","domain":"location","type":"counter","unit":"failures","description":"Location processing failures grouped by safe error class; no precise-location labels.","attributes":["service.name","deployment.environment.name","provider","region","error_code"],"collection":"increment once per failed processing attempt"},
    {"id":"marketplace.location.delivery.duration","domain":"location","type":"histogram","unit":"ms","description":"Location event delivery latency without recording route or location payload.","attributes":["service.name","deployment.environment.name","transport","region"],"collection":"record once per delivery"},
    {"id":"marketplace.payment.attempts","domain":"payments","type":"counter","unit":"attempts","description":"Aggregate payment attempt outcomes by provider, operation, and safe status only.","attributes":["service.name","deployment.environment.name","provider","operation","status"],"collection":"increment once per attempt; never include transaction identifiers"},
    {"id":"marketplace.payment.duration","domain":"payments","type":"histogram","unit":"ms","description":"Payment service/provider operation duration without payment payload or credentials.","attributes":["service.name","deployment.environment.name","provider","operation","status"],"collection":"record once per completed operation"},
    {"id":"marketplace.payment.provider.errors","domain":"payments","type":"counter","unit":"errors","description":"Payment provider failures grouped by provider and safe error class.","attributes":["service.name","deployment.environment.name","provider","operation","error_code"],"collection":"increment once per provider failure"},
    {"id":"marketplace.payment.webhook.failures","domain":"payments","type":"counter","unit":"failures","description":"Payment webhook processing failures by safe outcome; exclude payloads and identifiers.","attributes":["service.name","deployment.environment.name","provider","error_code"],"collection":"increment once per failed webhook"},
    {"id":"marketplace.payment.transaction.failures","domain":"payments","type":"counter","unit":"failures","description":"Payment operation failures grouped by safe status and operation.","attributes":["service.name","deployment.environment.name","provider","operation","status"],"collection":"increment once per failed operation"},
    {"id":"marketplace.payment.reconciliation.lag","domain":"payments","type":"gauge","unit":"s","description":"Age of the oldest pending reconciliation batch, without payment identifiers.","attributes":["service.name","deployment.environment.name","provider","region"],"collection":"sample every 60 seconds"},
    {"id":"marketplace.notification.sent","domain":"notifications","type":"counter","unit":"messages","description":"Notification delivery outcomes by channel, provider, and safe status; no recipient or body.","attributes":["service.name","deployment.environment.name","channel","provider","status"],"collection":"increment once per delivery outcome"},
    {"id":"marketplace.notification.delivery.duration","domain":"notifications","type":"histogram","unit":"ms","description":"Notification provider delivery duration without recipient or message content.","attributes":["service.name","deployment.environment.name","channel","provider","status"],"collection":"record once per delivery attempt"},
    {"id":"marketplace.notification.queue.age","domain":"notifications","type":"gauge","unit":"s","description":"Age of the oldest queued notification, without inspecting message content.","attributes":["service.name","deployment.environment.name","channel","queue"],"collection":"sample every 30 seconds"},
    {"id":"marketplace.notification.queue.depth","domain":"notifications","type":"gauge","unit":"messages","description":"Count of queued notifications by service and channel only.","attributes":["service.name","deployment.environment.name","channel","queue"],"collection":"sample every 30 seconds"},
    {"id":"marketplace.notification.retries","domain":"notifications","type":"counter","unit":"retries","description":"Notification retry events by bounded channel and safe reason.","attributes":["service.name","deployment.environment.name","channel","reason"],"collection":"increment once per retry"},
    {"id":"marketplace.notification.provider.failures","domain":"notifications","type":"counter","unit":"failures","description":"Notification provider failures by provider, channel, and safe error class.","attributes":["service.name","deployment.environment.name","provider","channel","error_code"],"collection":"increment once per provider failure"},
    {"id":"marketplace.security.authentication.failures","domain":"security","type":"counter","unit":"failures","description":"Authentication failures by safe reason, never by account or credential.","attributes":["service.name","deployment.environment.name","provider","reason","region"],"collection":"increment once per failed authentication"},
    {"id":"marketplace.security.authentication.attempts","domain":"security","type":"counter","unit":"attempts","description":"Aggregate authentication attempts with bounded result labels and no account identifiers.","attributes":["service.name","deployment.environment.name","provider","status","region"],"collection":"increment once per authentication attempt"},
    {"id":"marketplace.security.authentication.lockouts","domain":"security","type":"counter","unit":"events","description":"Account-protection lockout events by bounded reason and provider, without account identifiers.","attributes":["service.name","deployment.environment.name","provider","reason","region"],"collection":"increment once per lockout event"},
    {"id":"marketplace.security.authorization.denied","domain":"security","type":"counter","unit":"denials","description":"Authorization denials by safe action and reason class; no user identifiers.","attributes":["service.name","deployment.environment.name","action","reason","region"],"collection":"increment once per denial"},
    {"id":"marketplace.security.rate_limit.events","domain":"security","type":"counter","unit":"events","description":"Rate-limit events by service and bounded policy name, not client identifiers.","attributes":["service.name","deployment.environment.name","policy","region"],"collection":"increment once per rate-limit event"},
    {"id":"marketplace.security.anomalies","domain":"security","type":"counter","unit":"events","description":"Security anomaly classifications by safe rule and severity only.","attributes":["service.name","deployment.environment.name","rule","severity","region"],"collection":"increment once per classified anomaly"},
    {"id":"marketplace.security.control.failures","domain":"security","type":"counter","unit":"failures","description":"Security control failures by control name and safe result code.","attributes":["service.name","deployment.environment.name","control","result","region"],"collection":"increment once per control failure"},
    {"id":"marketplace.communication.messages","domain":"communication","type":"counter","unit":"messages","description":"Communication events by bounded channel and safe outcome, with no private message content.","attributes":["service.name","deployment.environment.name","channel","provider","status"],"collection":"increment once per accepted event"},
    {"id":"marketplace.communication.delivery","domain":"communication","type":"counter","unit":"deliveries","description":"Communication delivery outcomes by provider, channel, and safe status.","attributes":["service.name","deployment.environment.name","channel","provider","status"],"collection":"increment once per delivery outcome"},
    {"id":"marketplace.communication.provider.errors","domain":"communication","type":"counter","unit":"errors","description":"Communication provider errors by safe error class; never include destination identifiers.","attributes":["service.name","deployment.environment.name","provider","channel","error_code"],"collection":"increment once per provider error"},
    {"id":"marketplace.communication.provider.duration","domain":"communication","type":"histogram","unit":"ms","description":"Communication provider response duration by provider and channel only.","attributes":["service.name","deployment.environment.name","provider","channel"],"collection":"record once per provider request"},
    {"id":"marketplace.redis.health","domain":"redis","type":"gauge","unit":"state_code","description":"Redis dependency health state code: unavailable=0, degraded=1, healthy=2, unknown=-1.","attributes":["service.name","deployment.environment.name","cluster","region"],"collection":"refresh on transition and at least every 30 seconds"},
    {"id":"marketplace.redis.memory.utilization","domain":"redis","type":"gauge","unit":"ratio","description":"Redis memory use divided by configured memory limit.","attributes":["service.name","deployment.environment.name","cluster","node","region"],"collection":"sample every 30 seconds"},
    {"id":"marketplace.redis.command.duration","domain":"redis","type":"histogram","unit":"ms","description":"Redis command latency by bounded command class, never key or value.","attributes":["service.name","deployment.environment.name","cluster","command_class"],"collection":"record once per command"},
    {"id":"redis.evicted.keys","domain":"redis","type":"counter","unit":"keys","description":"Redis key eviction count by cluster; never inspect key names or values.","attributes":["service.name","deployment.environment.name","cluster","node"],"collection":"sample cumulative counter every 30 seconds"},
    {"id":"marketplace.redis.replication.lag","domain":"redis","type":"gauge","unit":"s","description":"Redis replication lag in seconds by cluster and replica role.","attributes":["service.name","deployment.environment.name","cluster","replica_role"],"collection":"sample every 30 seconds"}
  ]
}

