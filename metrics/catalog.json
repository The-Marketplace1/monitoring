{
  "version": 1,
  "format": "marketplace.monitoring.v1",
  "owner": "monitoring",
  "scope": "metrics",
  "implementation_status": "validated_provider_neutral_contract",
  "deployment_status": "not_deployed",
  "definitions_file": "definitions.json",
  "cardinality_policy": "never use user IDs, message content, precise coordinates, payment identifiers, or unbounded request values as metric attributes",
  "entries": [
    {"id": "application-instruments", "domain": "application", "signals": ["metrics"], "instruments": ["http.server.request.duration", "http.server.request.count", "rpc.server.duration", "marketplace.service.errors", "marketplace.service.health.status", "marketplace.gateway.upstream.errors"], "measurements": ["request success rate", "request latency", "HTTP 4xx", "HTTP 5xx", "service errors", "provider errors", "service health state", "upstream errors"], "required_attributes": ["service.name", "http.request.method", "http.response.status_code", "http.route"]},
    {"id": "infrastructure-instruments", "domain": "infrastructure", "signals": ["metrics"], "instruments": ["host.cpu.utilization", "host.memory.utilization", "host.disk.io", "host.network.errors", "container.restarts", "marketplace.capacity.utilization", "marketplace.gateway.saturation", "marketplace.worker.utilization"], "measurements": ["CPU", "memory", "disk", "network", "connection counts", "capacity", "gateway and worker saturation"], "required_attributes": ["host.name", "deployment.environment.name", "cloud.region"]},
    {"id": "database-instruments", "domain": "database", "signals": ["metrics"], "instruments": ["db.client.operation.duration", "db.client.connections.usage", "db.client.operation.errors", "marketplace.database.health", "marketplace.database.connection.utilization", "marketplace.database.replication.lag", "marketplace.database.backup.age", "marketplace.postgis.query.errors"], "measurements": ["query latency", "connection utilisation", "errors", "availability", "replication health", "backup health", "PostGIS query failures"], "required_attributes": ["db.system", "server.address", "deployment.environment.name"]},
    {"id": "realtime-instruments", "domain": "realtime", "signals": ["metrics"], "instruments": ["marketplace.realtime.connections", "marketplace.realtime.message.duration", "marketplace.realtime.disconnects", "marketplace.realtime.delivery.failures", "marketplace.realtime.subscription.failures"], "measurements": ["connection count", "connection failures", "event latency", "delivery failures", "subscription failures"], "required_attributes": ["service.name", "transport", "region"]},
    {"id": "location-instruments", "domain": "location", "signals": ["metrics"], "instruments": ["marketplace.location.updates", "marketplace.location.update_age", "marketplace.location.lookup.duration", "marketplace.location.processing.failures", "marketplace.location.delivery.duration"], "measurements": ["location update latency", "processing failures", "realtime delivery latency", "dependency health", "stale update count"], "required_attributes": ["service.name", "provider", "region"]},
    {"id": "payment-instruments", "domain": "payments", "signals": ["metrics"], "instruments": ["marketplace.payment.attempts", "marketplace.payment.duration", "marketplace.payment.provider.errors", "marketplace.payment.webhook.failures", "marketplace.payment.transaction.failures", "marketplace.payment.reconciliation.lag"], "measurements": ["payment latency", "payment-provider errors", "webhook failures", "transaction processing failures", "reconciliation lag"], "required_attributes": ["service.name", "provider", "operation", "status"]},
    {"id": "notification-instruments", "domain": "notifications", "signals": ["metrics"], "instruments": ["marketplace.notification.sent", "marketplace.notification.delivery.duration", "marketplace.notification.queue.age", "marketplace.notification.queue.depth", "marketplace.notification.retries", "marketplace.notification.provider.failures"], "measurements": ["delivery latency", "provider failures", "queue depth", "retry counts", "delivery success rate"], "required_attributes": ["service.name", "channel", "provider", "status"]},
    {"id": "security-instruments", "domain": "security", "signals": ["metrics"], "instruments": ["marketplace.security.authentication.failures", "marketplace.security.authentication.attempts", "marketplace.security.authentication.lockouts", "marketplace.security.authorization.denied", "marketplace.security.rate_limit.events", "marketplace.security.anomalies", "marketplace.security.control.failures"], "measurements": ["authentication attempts and failures", "authorisation failures", "rate-limit events", "suspicious operational patterns", "security-control failures"], "required_attributes": ["service.name", "reason", "action", "control"]},
    {"id": "communication-instruments", "domain": "communication", "signals": ["metrics"], "instruments": ["marketplace.communication.messages", "marketplace.communication.delivery", "marketplace.communication.provider.errors", "marketplace.communication.provider.duration"], "measurements": ["message throughput", "delivery outcomes", "provider failures", "provider latency"], "required_attributes": ["service.name", "channel", "provider", "status"]},
    {"id": "redis-instruments", "domain": "redis", "signals": ["metrics"], "instruments": ["marketplace.redis.health", "marketplace.redis.memory.utilization", "marketplace.redis.command.duration", "redis.evicted.keys", "marketplace.redis.replication.lag"], "measurements": ["availability", "memory utilization", "command latency", "evictions", "replication lag"], "required_attributes": ["service.name", "cluster", "deployment.environment.name"]}
  ]
}

